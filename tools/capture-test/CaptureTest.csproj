<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);CA1416;CS0168;CS0219</NoWarn>
    <RootNamespace>CaptureTest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestMain.cs" />
    <Compile Include="RestoreSelfTest.cs" />
    <Compile Include="..\..\src\WinBC\Settings.cs" />
    <Compile Include="..\..\src\WinBC\Models\*.cs" />
    <Compile Include="..\..\src\WinBC\Native\*.cs" />
    <Compile Include="..\..\src\WinBC\Util\*.cs" />
    <Compile Include="..\..\src\WinBC\Storage\*.cs" />
    <Compile Include="..\..\src\WinBC\Restore\*.cs" />
    <Compile Include="..\..\src\WinBC\Capture\*.cs" />
  </ItemGroup>

</Project>
